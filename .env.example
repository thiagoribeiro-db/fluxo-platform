# Supabase
# Pegue em: https://supabase.com/dashboard/project/<seu-projeto>
#   → Botão "Connect" no topo → App Frameworks → Next.js
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# (Opcional) Service role — só necessário pra tarefas administrativas/webhooks
# Pegue em: Settings → API → service_role
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Next.js — URL base do app (usada no redirectTo do magic link)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic Claude API — interpretação de PDF/DOCX/TXT em fluxos conversacionais.
# Pegue em: https://console.anthropic.com/settings/keys
# Modelo padrão usado: claude-opus-4-7 (alta qualidade, streaming, adaptive thinking)
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# (Opcional) Sentry — error tracking em produção
# Pegue em: https://sentry.io → Settings → Projects → Client Keys (DSN)
# Em dev, deixe vazio pra não enviar eventos. Em prod (Vercel), seta no dashboard.
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# Pra upload de source maps no build (opcional, só prod):
# Account → API → Auth Tokens (escopo: project:releases)
# SENTRY_ORG=sua-org
# SENTRY_PROJECT=fluxo-platform
# SENTRY_AUTH_TOKEN=sntrys_xxx

# (Opcional) PostHog — analytics de uso do produto
# Pegue em: https://app.posthog.com/project/settings
# Em dev, deixe vazio. Em prod (Vercel), seta no dashboard.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
