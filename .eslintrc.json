{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "no-console": [
      "warn",
      {
        "allow": ["error"]
      }
    ],
    "no-unused-vars": "off",
    "@typescript-eslint/no-require-imports": "off",
    "prefer-const": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "react/no-unescaped-entities": "off"
  },
  "ignorePatterns": [
    "node_modules",
    ".next",
    "tmp",
    "out",
    "build",
    "public",
    "next-env.d.ts"
  ],
  "overrides": [
    {
      "files": ["lib/utils/logger.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["lib/actions/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
